# Copy to docker/.env (git-ignored). Local development values only.
KAIROS_PG_USER=kairos
KAIROS_PG_PASSWORD=change-me-local-only
KAIROS_REPLICATION_PASSWORD=change-me-local-only
KAIROS_VAULT_TOKEN=kairos-dev-root
KAIROS_KEYCLOAK_ADMIN=change-me-local-only

# Optional: newer LocalStack releases need an account token.
LOCALSTACK_AUTH_TOKEN=

# Self-hosted agent: PAT with "Agent Pools (Read & manage)" scope only, short expiry.
AZP_URL=https://dev.azure.com/<your-org>
AZP_TOKEN=
AZP_POOL=Kairos-Local
AZP_AGENT_NAME=kronoslaptop-docker
