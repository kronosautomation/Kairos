<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CA1707;CA1515;CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Kairos.Hosting\Kairos.Hosting.csproj" />
    <ProjectReference Include="..\..\src\Kairos.Cli\Kairos.Cli.csproj" />
    <ProjectReference Include="..\..\src\Kairos.Worker\Kairos.Worker.csproj" />
    <ProjectReference Include="..\..\src\Kairos.Mcp.TaskStore\Kairos.Mcp.TaskStore.csproj" />
    <ProjectReference Include="..\..\src\Kairos.Cloud.SelfHosted\Kairos.Cloud.SelfHosted.csproj" />
    <ProjectReference Include="..\Kairos.Testing\Kairos.Testing.csproj" />
    <ProjectReference Include="..\Kairos.Conformance\Kairos.Conformance.csproj" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <!-- The failover test builds the same primary and replica as docker/compose.yml, from the same scripts. -->
    <Content Include="..\..\docker\postgres\*.sh" Link="Faults\scripts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
