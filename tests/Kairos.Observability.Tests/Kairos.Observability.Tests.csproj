<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CA1707;CA1515;CA2007;CA1062;CA1859;CA1861;CA1812;MEAI001;MAAI001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Kairos.Agents\Kairos.Agents.csproj" />
    <ProjectReference Include="..\..\src\Kairos.Agents.AgentFramework\Kairos.Agents.AgentFramework.csproj" />
    <ProjectReference Include="..\..\src\Kairos.Hosting\Kairos.Hosting.csproj" />
    <ProjectReference Include="..\..\src\Kairos.Worker\Kairos.Worker.csproj" />
    <ProjectReference Include="..\..\src\Kairos.Cloud.SelfHosted\Kairos.Cloud.SelfHosted.csproj" />
    <ProjectReference Include="..\Kairos.Testing\Kairos.Testing.csproj" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.InMemory" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Kairos.Analyzers\Kairos.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <!-- The agent test harness is shared source, not a package. -->
    <Compile Include="..\Kairos.Agents.Tests\AgentHarness.cs" Link="Shared\AgentHarness.cs" />
    <Compile Include="..\Kairos.Agents.AgentFramework.Tests\AfHarness.cs" Link="Shared\AfHarness.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
