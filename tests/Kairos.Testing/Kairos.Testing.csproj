<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Kairos.Testing</PackageId>
    <Description>The Kairos simulator kit: a virtual clock, deterministic simulation world, fault injection, crash-at-every-step helpers, store contract tests, and scripted models for testing your own workflows and agents.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsTestProject>false</IsTestProject>
    <!-- Test support: underscored test names, no public-API polish required. -->
    <NoWarn>$(NoWarn);CA1707;CA1515;CA1062;CA1859;CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Kairos.Core\Kairos.Core.csproj" />
    <ProjectReference Include="..\..\src\Kairos.Agents\Kairos.Agents.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit" />
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
