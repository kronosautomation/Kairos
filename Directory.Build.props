<Project>

  <PropertyGroup>
    <!-- CI switches every project at once with -p:KairosTargetFramework=net11.0. (A global TargetFramework is not passed to
         project references, so overriding TargetFramework itself builds references for the wrong framework.) -->
    <KairosTargetFramework Condition="'$(KairosTargetFramework)' == ''">net10.0</KairosTargetFramework>
    <TargetFramework>$(KairosTargetFramework)</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Reproducible builds: no path of the machine that built it may end up in the output. The compiler writes the PDB's location into the assembly, so building the same commit in
       another directory gives other bytes unless the root is mapped. (The SDK does this itself only when source control information is available; this does not depend on that.) -->
  <PropertyGroup Condition="'$(ContinuousIntegrationBuild)' == 'true'">
    <DeterministicSourcePaths>false</DeterministicSourcePaths>
    <PathMap>$(MSBuildThisFileDirectory)=/_/</PathMap>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Warnings are errors; analyzers run at the strictest recommended level, including in the build. -->
    <!-- Package metadata: everything in this repository is Apache-2.0 (docs/LICENSING.md). -->
    <Authors>Kronos Automation LLC</Authors>
    <Company>Kronos Automation LLC</Company>
    <Copyright>Copyright 2026 Kronos Automation LLC</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Features>strict</Features>

    <!-- Supply chain: lock files + NuGetAudit. High/critical advisories surface as warnings, hence build errors. -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>high</NuGetAuditLevel>
  </PropertyGroup>

  <!-- Public packages publish their XML comments; the docs site builds its API reference from them.
       Members without a summary (CS1591) are listed but not yet an error. Every other documentation warning is an error. -->
  <PropertyGroup Condition="$(MSBuildProjectFullPath.Contains('src'))">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

</Project>
